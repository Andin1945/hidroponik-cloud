POST {{apiBaseUrl}}/nutrisi
Content-Type: application/json

{
  "tanaman_id": 1,
  "jenis_nutrisi": "AB Mix",
  "jumlah_ml": 50,
  "tanggal_pemberian": "2026-05-24",
  "keterangan": "Pemberian nutrisi rutin"
}


### UPDATE NUTRISI
PUT {{apiBaseUrl}}/nutrisi/1
Content-Type: application/json

{
  "tanaman_id": 1,
  "jenis_nutrisi": "AB Mix Update",
  "jumlah_ml": 60,
  "tanggal_pemberian": "2026-05-25",
  "keterangan": "Pemberian nutrisi tambahan"
}


### DELETE NUTRISI
DELETE {{apiBaseUrl}}/nutrisi/1


##################################################
# JADWAL PERAWATAN API
##################################################

### GET ALL JADWAL
GET {{apiBaseUrl}}/jadwal


### GET JADWAL BY ID
GET {{apiBaseUrl}}/jadwal/1


### CREATE JADWAL
POST {{apiBaseUrl}}/jadwal
Content-Type: application/json

{
  "tanaman_id": 1,
  "kegiatan": "Cek pH Air",
  "tanggal_jadwal": "2026-05-25",
  "status": "belum",
  "catatan": "Pastikan pH berada di kisaran 5.5 - 6.5"
}


### UPDATE JADWAL
PUT {{apiBaseUrl}}/jadwal/1
Content-Type: application/json

{
  "tanaman_id": 1,
  "kegiatan": "Cek pH dan PPM",
  "tanggal_jadwal": "2026-05-26",
  "status": "selesai",
  "catatan": "Pengecekan sudah dilakukan"
}


### DELETE JADWAL
DELETE {{apiBaseUrl}}/jadwal/1


##################################################
# NOTIFICATIONS API
##################################################

### GET ALL NOTIFICATIONS
GET {{apiBaseUrl}}/notifications


### GET UNREAD NOTIFICATIONS COUNT
GET {{apiBaseUrl}}/notifications/unread-count


### CREATE NOTIFICATION
POST {{apiBaseUrl}}/notifications
Content-Type: application/json

{
  "title": "Data Tanaman Ditambahkan",
  "message": "Data tanaman baru berhasil ditambahkan melalui REST Client.",
  "type": "create"
}


### MARK ALL NOTIFICATIONS AS READ
PUT {{apiBaseUrl}}/notifications/read-all


### DELETE NOTIFICATION
DELETE {{apiBaseUrl}}/notifications/1